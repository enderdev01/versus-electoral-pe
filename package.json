{
  "name": "transparencia-electoral",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && npm run gen:fotos-manifest && next build",
    "gen:fotos-manifest": "npx tsx scripts/gen-fotos-manifest.ts",
    "start": "next start",
    "lint": "eslint",
    "check:isr": "npx tsx scripts/check-isr-budget.ts",
    "db:push": "npx prisma db push",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "ingest:planes-municipales": "npx tsx scripts/ingestar-planes-municipales.ts",
    "ingest:fotos-municipales": "npx tsx scripts/ingestar-fotos-municipales.ts",
    "backfill:noticias-municipales": "npx tsx scripts/backfill-noticias-municipales.ts",
    "db:studio": "npx prisma studio",
    "scrape": "curl -X POST http://localhost:3000/api/scrape -H 'Authorization: Bearer dev-key-123'",
    "cron": "npx tsx scripts/cron-local.ts",
    "gen:avatars": "npx tsx scripts/download-images.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "next": "16.1.6",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
